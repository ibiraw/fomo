# Copy to server.env on the VPS and fill in. Never commit server.env.
SOLANA_RPC_HTTP=https://...
SOLANA_RPC_WSS=wss://...
ETH_RPC_HTTP=https://...
ETH_RPC_WSS=wss://...
BASE_RPC_HTTP=https://...
BASE_RPC_WSS=wss://...
BNB_RPC_HTTP=https://...
BNB_RPC_WSS=wss://...
ROBINHOOD_RPC_HTTP=https://...
ROBINHOOD_RPC_WSS=wss://...
ARC_RPC_HTTP=https://...
ARC_RPC_WSS=wss://...
# Paywall (off until PAYWALL_ENABLED=true). Treasury = the fresh wallets that receive payments.
PAYWALL_ENABLED=false
# PAY_SOLANA_TREASURY=
# PAY_EVM_TREASURY=
# PAY_TOKEN=            # once launched: Solana mint or <chain>:<0xaddress>
# UNLOCK_PRICE_USD=50
# UNLOCK_TOKEN_PRICE_USD=35
# FREE_ORDERS=3
# ACCESS_PERIOD_DAYS=30
# Optional
# JUPITER_API_KEY=
# MAX_ACTIVE_ORDERS_PER_USER=25
# Telegram monitoring (bot from @BotFather + your chat id)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
